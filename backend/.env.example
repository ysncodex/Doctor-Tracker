NODE_ENV=development
PORT=5000

MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:3000
ADMIN_PASSWORD=

# Optional. Number of reverse proxies in front of the API (the Next.js rewrite counts as 1).
# Set to 0 only if the API is exposed directly to the internet.
TRUST_PROXY_HOPS=1
